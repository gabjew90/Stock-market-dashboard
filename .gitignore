# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/

# The corpus (raw/posts/ + raw/posts.jsonl) IS committed: it is Layer 1, the
# source of truth every wiki citation links into, and `ww lint` can only verify
# those links when it is present. ~22 MB of markdown — worth it to make CI
# checkouts and blocked-egress environments self-sufficient.
# raw/api/ stays ignored: it is a redundant JSON cache of the same content,
# re-fetchable with `ww scrape`.
/raw/api/
/raw/api-comments/
/data/index/

# generated single-file site
/wiki_site.html
/wiki_site_*.html
/wiki_site_*.zip
/wiki_site_*.txt

# generated dashboard (rebuilt by scripts/build_market_regime.py + build-dashboard workflow)
/market_regime.html
# legacy filename — kept ignored so any leftover local copy doesn't get committed
/gmi_playground_daily.html
/.playwright-mcp/

# generated timeline dataset (rebuild with `ww timeline`)
/raw/timeline.parquet

# breadth data (rebuild with `ww breadth fetch && ww breadth build`)
/data/breadth/

# backtest artifacts (rebuild with `ww backtest timing-overlay`)
/data/backtest/
